# Unity rebuilds these on every computer, so they're never uploaded (Library alone is over 1 GB)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset .meta files must be kept: they hold the IDs prefabs and scenes use to find assets
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider files, regenerated by Unity when the project opens
.vs/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and finished builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
